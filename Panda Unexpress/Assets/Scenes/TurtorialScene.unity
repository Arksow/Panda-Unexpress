  textUI: {fileID: 2086145166}
  tutorialCustomerController: {fileID: 1625447336}
  steps:
  - stepText: welcome
    highlights: []
  - stepText: grab cup
    highlights:
    - {fileID: 677795155}
  - stepText: get ice scoop and bring your cup with you
    highlights:
    - {fileID: 406880498}
    - {fileID: 5341444913038917499}
  - stepText: dip ice scoop in ice box
    highlights:
    - {fileID: 406880498}
    - {fileID: 380552644}
  - stepText: tilt the scoop into the cup
    highlights:
    - {fileID: 406880498}
  - stepText: You can combine two bases to make a receipe. But be careful! Some bases
      don't mix well and ruins the cup. Put some milk.
    highlights:
    - {fileID: 2041936614}
  - stepText: Next some tea to make milk tea
    highlights:
    - {fileID: 1983252893}
  - stepText: put sugar,control the level to set amount
    highlights:
    - {fileID: 426899533}
  - stepText: get boba, then you can put it in the cup
    highlights:
    - {fileID: 1102328927}
    - {fileID: 1755148663}
  - stepText: Now seal the cup!
    highlights:
    - {fileID: 1407280068}
  - stepText: now use the speaker and get a fresh cup from the dispenser, say 'REFILL'
    highlights:
    - {fileID: 2106703194}
    - {fileID: 739928266}
  - stepText: You have learnt how to make boba, and a customer has came. Serve him
      his order to complete the turtorial!
    highlights: []
  - stepText: completed turtorial
    highlights: []
